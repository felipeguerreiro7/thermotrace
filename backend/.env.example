# Copie para .env e ajuste. O .env NUNCA vai para o Git.
#
# Gere uma SECRET_KEY real com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

AMBIENTE=local
DEBUG=true

DATABASE_URL=postgresql+psycopg://thermotrace:senha_local@localhost:5432/thermotrace
DB_ECHO=false

SECRET_KEY=COLE_AQUI_UMA_CHAVE_GERADA_DE_VERDADE
ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=30

# Vazio = nenhuma origem liberada. O app Android nao usa CORS.
ORIGENS_PERMITIDAS=[]

DIRETORIO_ARQUIVOS=./dados/arquivos
TAMANHO_MAXIMO_MB=25

# E-mail (Fase 5)
RESEND_API_KEY=
EMAIL_REMETENTE=alertas@seudominio.com.br
EMAIL_NOME_REMETENTE=ThermoTrace

NIVEL_LOG=INFO
LOG_JSON=false
