# Copie para .env e ajuste. O .env NUNCA vai para o Git.
#
# Gere uma SECRET_KEY real com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

AMBIENTE=local
DEBUG=true

DATABASE_URL=postgresql+psycopg://thermotrace:senha_local@localhost:5432/thermotrace
DB_ECHO=false

SECRET_KEY=COLE_AQUI_UMA_CHAVE_GERADA_DE_VERDADE
ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=30

# Vazio = nenhuma origem liberada. O app Android nao usa CORS.
ORIGENS_PERMITIDAS=[]

DIRETORIO_ARQUIVOS=./dados/arquivos
TAMANHO_MAXIMO_MB=25

# E-mail (Fase 5)
RESEND_API_KEY=
EMAIL_REMETENTE=alertas@seudominio.com.br
EMAIL_NOME_REMETENTE=ThermoTrace

NIVEL_LOG=INFO
LOG_JSON=false

# Liga o botão "Entrar na demonstração" no portal. Nunca em produção.
DEMO_PUBLICA=false

# Atrás de proxy (ver app/core/rede.py). Local: deixar vazio.
# No Render, onde a borda é a Cloudflare: IP_CLIENTE_CABECALHO=CF-Connecting-IP
IP_CLIENTE_CABECALHO=
# Endereço público HTTPS impresso no relatório (link e QR de conferência).
URL_PUBLICA=
