<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Localizacao da coleta. Apenas em primeiro plano: o app nunca precisa da
      posicao com a tela apagada, e pedir background seria coletar mais do que
      a funcao exige. Aproximada basta para dizer a cidade; fina, para a doca.
      Negar a permissao nao impede nenhuma operacao.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-feature android:name="android.hardware.nfc" android:required="true" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application
        android:name=".ThermoTraceApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.ThermoTrace"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <!--
          allowBackup=false é deliberado: o banco local guarda evidência de
          auditoria (leituras brutas de etiqueta, hashes, cadeia de custódia).
          Backup automático em nuvem de terceiro tiraria esse dado do nosso
          controle e quebraria a cadeia de responsabilidade.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ThermoTrace">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- QR impresso na etiqueta: https://app.thermotrace.com.br/t/TT-XXXX -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="app.thermotrace.com.br"
                      android:pathPrefix="/t/" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.components.CapturaDocumentoActivity"
            android:exported="false" android:screenOrientation="fullSensor"
            android:theme="@style/zxing_CaptureTheme" android:windowSoftInputMode="stateAlwaysHidden" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
